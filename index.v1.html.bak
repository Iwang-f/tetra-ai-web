                    <div class="feature-chip">Tanpa Studio Fisik</div>
                    <div class="feature-chip">Tanpa Biaya Talent</div>
                    <div class="feature-chip">Voice-over AI Premium</div>
                    <div class="feature-chip">Optimasi TikTok/Reels</div>
                    <div class="feature-chip">Hemat 80% Biaya</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Kenapa TETRA? Feature Bento Grid -->
